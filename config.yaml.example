# Gemini Crawl Configuration File

browser:
  proxy: "http://127.0.0.1:7890"
  headless: true
  typing_delay_ms: 5
  user_agent: "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
  viewport:
    width: 1280
    height: 900

task:
  timeout_seconds: 45
  min_image_dimension: 150
  output_dir: "./output"

gateway:
  bind_host: "127.0.0.1"
  port: 4981
  model: "gemini-web-image"
  max_upload_bytes: 10485760
  eager_start: true
  cors_origins:
    - "http://127.0.0.1:4981"
    - "http://localhost:4981"

logging:
  level: "INFO"
