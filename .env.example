# Gemini Web session credential. Never commit a real cookie.
GEMINI_RAW_COOKIES="SID=...; __Secure-1PSID=...; ..."

# Optional outbound proxy used by the Playwright browser.
PROXY_SERVER="http://127.0.0.1:7890"
HEADLESS="true"

# Local-only by default. A 32+ character token is mandatory for non-loopback binds.
GATEWAY_BIND_HOST="127.0.0.1"
GATEWAY_PORT="4981"
GATEWAY_API_TOKEN=""
GATEWAY_MODEL="gemini-web-image"
GATEWAY_EAGER_START="true"
GATEWAY_MAX_UPLOAD_BYTES="10485760"
GATEWAY_CORS_ORIGINS="http://127.0.0.1:4981,http://localhost:4981"
